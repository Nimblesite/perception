// Perception Studio end to end: the real editor driven through the typed host event boundary every host
// calls ([NATIVE-SHM-EVENT]), its song, patch and transport journeys.

import ui::Runtime
import uitest::Drive
import uitest::Semantics
import uitest::Views
import signalflow::App

playingBars24 = "Playing bars 2–4 of Bridge."
renderingAllOfBridge = "Rendering all of Bridge."
theSongIsAlready = "The song is already playing; Stop first."
noRenderer = "Perception Studio was launched without its song renderer, so it cannot play or render this song."

hosted work =
    handle ui::Slices
        fetch _ => ""
    ui::Views::quiet work

// The test `name`: its journey driven through the host inside the runtime's guard.
hostedTest (name, journey) = test (name, \() => Runtime::guarded (\() => hosted journey))

// The test `name`: its journey inside the runtime's guard.
journeyTest (name, journey) = test (name, \() => Runtime::guarded journey)

// The window paints Perception Studio's own background around the canvas, never the host's black.
windowBackground () = match ui::Themes::named (App::theme "prism", "background")
    Success token => expect (token.tokenDark, "#100D21")
    Error _ => expect ("no background token", "#100D21")

test ("a patch opened in its own window keeps its inspector in that window however the song window is sized, on Perception Studio's own background", \() => Runtime::guarded (\() =>
    windowBackground ()
    hosted detachedRoomJourney))

hostedTest ("a module chosen on the main window's Patch page shows its properties in the docked panel, never on the canvas", mainPanelJourney)

hostedTest ("View → Patch Controls toggles the patch panel: it puts away a docked panel and shows a hidden one", patchControlsTogglesPanelJourney)

// The editor after wiring `source`'s outlet `outlet` into `destination`'s inlet `inlet`, as the socket controls do.
wired (editor, source, outlet, destination, inlet) = tapped (tapped (editor, synth::Source(identity = source, outlet = outlet)), synth::Connect(identity = destination, inlet = inlet))

// The editor after an action, as its controls leave it.
tapped (editor, action) = synth::EditorState::tapped (editor, action)

// The editor after `c`'s output socket is tapped onto its input socket.
socketWired (editor, c) = wired (editor, c.s, 0, c.d, c.i)

// The editor after `identity` is chosen and removed, its cables with it.
removedNode (editor, identity) = tapped (tapped (editor, synth::Select(identity = identity)), synth::Remove)

// A refused edit leaves the graph exactly as it was and says why.
refusedEdit (before, after) =
    expect (structuralEquals (after.graph, before.graph), true)
    nonEmpty after.message

// `action` on `editor` is refused.
refusedTap (editor, action) = refusedEdit (editor, tapped (editor, action))

hasCable (editor, c) = expect (length (filterList (editor.graph.cables, \k => k.source == c.s && k.destination == c.d && k.inlet == c.i)), 1)

// [STUDIO-ROUTING-VERIFY] Two sines, two gains, a mixer, an output and a MIDI generator: one sine fans out to both
// gains, the gains merge in the mixer, and every refused edit (an event outlet into audio, a cycle, a missing
// inlet) leaves the snapshot unchanged; a route comes out and goes back, and a connected node takes its cables.
addedModules kinds = foldList (kinds, synth::EditorState::initial (), \(editor, kind) => tapped (editor, synth::Add(kind = kind)))

graphEditJourney () =
    added = addedModules socketKinds
    expect (mapList (added.graph.nodes, \n => n.identity), [0, 1, 2, 3, 4, 5, 6])
    patched = foldList (socketRoutes, added, socketWired)
    forEachList (socketRoutes, \c => hasCable (patched, c))
    forEachList (listConcat socketRefusedRoutes [{ s = 1, d = 5, i = 3 }, { s = 1, d = 9, i = 0 }], \bad => refusedEdit (patched, socketWired (patched, bad)))
    refusedTap (patched, synth::Source(identity = 1, outlet = 4))
    unplugged = tapped (patched, synth::Disconnect(identity = 3, inlet = 0))
    lengths (patched.graph.cables, 5, unplugged.graph.cables, 4)
    refusedTap (unplugged, synth::Disconnect(identity = 3, inlet = 0))
    rerouted = wired (unplugged, 1, 0, 3, 0)
    hasCable (rerouted, { s = 1, d = 3, i = 0 })
    expect (length (filterList (rerouted.graph.cables, \k => k.source == 0)), 1)
    gone = removedNode (rerouted, 4)
    expect (mapList (gone.graph.nodes, \n => n.identity), [0, 1, 2, 3, 5, 6])
    lengths (rerouted.graph.cables, 5, gone.graph.cables, 2)
    forEachList ([{ s = 0, d = 2, i = 0 }, { s = 1, d = 3, i = 0 }], \c => hasCable (gone, c))
    expect (gone.selected, -1)
    expect (gone.selected, -1)

// [STUDIO-ROUTING-EDITOR] The editor's actual actions create independent routable instances: three modules wired socket by socket.
componentsJourney () =
    output = addedModules starterChain
    expect (length output.graph.nodes, 3)
    routed = wired (output, 0, 0, 1, 0)
    second = wired (routed, 1, 0, 2, 0)
    lengths (routed.graph.cables, 1, second.graph.cables, 2)
    refusedTap (second, synth::Connect(identity = 1, inlet = 0))
    removed = removedNode (second, 1)
    lengths (removed.graph.nodes, 2, removed.graph.cables, 0)
    expect (removed.nextIdentity, 3)
    graphEditJourney ()

journeyTest ("the modular editor adds, connects and removes independent synth components", componentsJourney)

hostedTest ("native component menus and cable controls edit the same graph drawn on the canvas", editorUiJourney)

hostedTest ("canvas sockets fan out, merge, refuse a cycle and an event route, cut, redraw and delete a connected node", socketGraphJourney)

journeyTest ("a patch with no saved positions is laid out along its signal flow", flowLayoutJourney)

hostedTest ("VST discovery creates typed independent plug-in nodes through native controls", pluginUiJourney)

journeyTest ("VST audio packets preserve float samples, stereo frames and exact MIDI offsets", hostWireJourney)

hostedTest ("MIDI generators and stereo outputs are available through native graph controls", midiMenuJourney)

hostedTest ("a formula melody is added, typed, refused with its column and heard through native graph controls [SYNTH-FORMULA-NOTES]", formulaMenuJourney)

journeyTest ("MIDI note-on and note-off ownership survives exact block partitions", midiTimingJourney)

journeyTest ("hosted graph execution shares exact builtin PCM and rejects malformed cached buffers", graphClipJourney)
hostedTest ("original Perception Studio sliders and module palette operate the editable graph", studioIntegratedJourney)
hostedTest ("patch inspector shows only the selected module and preserves routing", inspectorJourney)

// Shared assertions on a driven synth: each names the one field it checks.
cablesOf (d, count) = expect (length (Drive::holding d).graph.cables, count)

// The driven editor's cable count, and whether its canvas offers the cable `label`.
cablesOffered (d, count, label, shown) =
    cablesOf (d, count)
    offeredIn (d, label, shown)

sameGraph (one, other) = expect (structuralEquals ((Drive::holding one).graph, (Drive::holding other).graph), true)

selectedIs (d, identity) = expect ((Drive::holding d).selected, identity)

showsIn (d, text, shown) = expect (Drive::shows (d, text), shown)

offeredIn (d, label, shown) = expect (Semantics::offered (d.drivenSeen.renderedAccess, label), shown)

viewShows (d, text, shown) = expect (Views::shows (d.drivenSeen, text), shown)

// A text that says something.
nonEmpty (text) = expect (text != "", true)

portAt (d, label, left, top) =
    port = Semantics::element (d.drivenSeen.renderedAccess, label)
    expect (port.accessLeft, left)
    expect (port.accessTop, top)

succeeds (outcome, check) = match outcome
    Error why =>
        print "# expected success, got ${why}"
        expect (false, true)
    Success value => check value

reads (outcome, check) = match outcome
    Error why => expect ("no element ${why.index} of ${why.length}", "an element")
    Success value => check value

valid (outcome, check) = match outcome
    synth::Invalid _ => expect (false, true)
    synth::Valid value => check value

// The `index`th parameter of graph node `identity`, which must exist.
parameterAt (graph, identity, index, check) = valid (synth::Graphs::node (graph, identity), \n => reads (listGet n.parameters index, check))

hostedTest ("graph history undoes module insertion, redoes it and branches without reusing identities", graphHistoryJourney)

hostedTest ("resizing the graph keeps original header controls aligned and usable", graphResizeJourney)

// [DAW-TRACK-PATCH] The timeline's tracks against Perception Studio: a patch track opens as its graph, a built-in one as a
// single voice node wired to the output, and a missing row says why nothing opens.
piece (identity, component, settings) = daw::PatchNode(identity = identity, component = component, size = 0, seed = 0, asset = "", settings = settings)

cabled (source, outlet, destination, inlet) = daw::PatchCable(source = source, outlet = outlet, destination = destination, inlet = inlet)

// A track as it is created: named around its instrument, at unity gain, centred, on no bus, with nothing else.
freshTrack (name, instrument) = daw::Track(name = name, instrument = instrument, gain = 1.0, pan = 0.0, bus = "", sends = [], positions = [], notes = [])

// A track holding `nodes` and `cables` as its patch, from an attack of 10 ms to a release of `release`.
patchTrack (name, nodes, cables, release) = freshTrack (name, daw::PatchInstrument(routing = daw::Routing(nodes = nodes, cables = cables, attack = 0.01, release = release)))

// A track whose patch is the chain `nodes`, each cabled into the next, from an attack of 10 ms to `release`.
chainTrack (name, nodes, release) = patchTrack (name, nodes, serial (length nodes), release)

// Cables joining `count` nodes in a row: each outlet 0 into the next node's inlet 0.
serial (count) = mapList (toList (range (1, count)), \i => cabled (i, 0, satAdd i 1, 0))

// A setting a parameter follows: pitched, struck or constant.
setting (key, value, follow) = daw::Setting(key = key, value = value, follow = follow)

// A note struck at `pitch` from beat `start`, held for `held` beats, at `velocity`.
beamed (pitch, start, held, velocity) = daw::Note(pitch = pitch, start = start, length = held, velocity = velocity)

// The keys patch: a sine an octave above the note through a struck gain of half, into the output.
keysTrack () = chainTrack ("keys", [piece (1, "sine", [setting ("frequency", 2.0, daw::Pitched)]), piece (2, "gain", [setting ("gain", 0.5, daw::Struck)]), piece (3, "output", [])], 0.1)

bellTrack () = freshTrack ("bell", daw::BellInstrument(decay = 2.0, brightness = 0.5))

timeline tracks = daw::Arrangement(title = "Bridge", tempo = 120.0, meterTop = 4, meterBottom = 4, sampleRate = 48000, buses = [], tracks = tracks)

pluckTrack () = freshTrack ("pluck", daw::PluckInstrument(brightness = 0.7, decay = 0.9))

settled (graph, identity, key, value) = valid (synth::Graphs::node (graph, identity), \n => reads (listGet (filterList (n.parameters, \p => p.key == key)) 0, \p => expect (toString p.initial, toString value)))

// Two lengths that must match.
lengths (one, first, other, second) =
    expect (length one, first)
    expect (length other, second)

// The channel counts of `ports`, in order.
widths (ports) = mapList (ports, \p => p.channels)

// The frequency MIDI `midi` sounds an octave above.
octaveAbove midi = synth::Waves::midiFrequency midi * 2.0

// The keys patch as it reopens: sine an octave above middle C through half gain.
keysSaved graph =
    settled (graph, 1, "frequency", octaveAbove 60.0)
    settled (graph, 2, "gain", 0.5)

// A built-in voice: one node feeding the output through one cable.
voiced graph =
    expect ([length graph.nodes, length graph.cables], [2, 1])
    settled (graph, 1, "frequency", synth::Waves::midiFrequency 60.0)

// A built-in voice's tone: the decay and brightness it reopens with.
toned (graph, decay, brightness) =
    voiced graph
    settled (graph, 1, "decay", decay)
    settled (graph, 1, "brightness", brightness)

failsWith (outcome, message) = match outcome
    Error why => expect (why, message)
    Success _ => expect ("a patch", message)

trackPatchJourney () =
    song = timeline [bellTrack (), keysTrack (), pluckTrack ()]
    succeeds (daw::TrackPatches::picked (song, 1), \graph =>
        lengths (graph.nodes, 3, graph.cables, 2)
        keysSaved graph)
    succeeds (daw::TrackPatches::picked (song, 0), \graph =>
        toned (graph, 2.0, 0.5)
        settled (graph, 1, "body", 3.0))
    succeeds (daw::TrackPatches::picked (song, 2), \graph =>
        toned (graph, 0.9, 0.7))
    failsWith (daw::TrackPatches::picked (song, 3), "The arrangement has no track 3.")
    failsWith (daw::TrackPatches::picked (timeline [], 0), "The arrangement has no track 0.")
    succeeds (daw::TrackPatches::patch (keysTrack ()), \graph => expect (length graph.nodes, 3))

journeyTest ("tapping a timeline track opens its own patch in Perception Studio; built-in tracks open as one voice, missing ones say why not", trackPatchJourney)

// [DAW-PATCH-HEARD] A module left unwired in Perception Studio, or wired to nothing that reaches the output, stays in the
// saved patch and in Perception Studio but is silent: each note renders exactly as it does without it.
strayed route = route(nodes = listConcat route.nodes [piece (9, "mixer", []), piece (8, "gain", [fixed ("gain", 0.9)])], cables = listAppend route.cables (cabled (1, 0, 8, 0)))

// [DAW-RENDER-PLAY] One track through the same block path Playback runs: its buses after `count` frames.
trackBuses (song, buses, voice, count) = synth::Outcomes::carried (daw::Arrangements::opened (song, voice), \play =>
    synth::Outcomes::carried (daw::Arrangements::advanceWindow (song, buses, voice, play, 0, count), \step => Success(value = step.buses)))

// A track's own sound: played alone, centred at unity, read back from Master's left side.
trackPart (song, voice, count) = synth::Outcomes::carried (trackBuses (song, daw::Arrangements::empty, voice(gain = 1.0, pan = 0.0, bus = "", sends = []), count), \buses =>
    Success(value = mapList (buses.left, \value => value / daw::ArrangeMath::panLeft 0.0)))

// A note as the graph plays it, from the first frame to the end of its span.
sampledAt (note, instrument, tempo) = synth::Outcomes::carried (daw::NoteRenders::checkedSpan (note, tempo, 48000.0, instrument), \span =>
    voice = freshTrack ("note", instrument)
    song = timeline [voice]
    trackPart (song(tempo = tempo), voice(notes = [note(start = 0.0)]), span.total))

sampledNote (note, instrument) = sampledAt (note, instrument, 120.0)

comparedNote (note, plain, patch, inspect) = succeeds (sampledNote (note, plain), \expected =>
    succeeds (sampledNote (note, patch), \heard =>
        expect (length heard, length expected)
        inspect (heard, expected)))

noteSounds (heard, expected) = expect (length (filterList (heard, \sample => sample != 0.0)) > 0, expected)

heardAlike (note, plain, stray) = comparedNote (note, plain, stray, \(heard, expected) =>
    noteSounds (heard, true)
    expect (structuralEquals (heard, expected), true))

// A patch with an input left unplugged renders the whole note; `sounding` says whether anything is heard.
rendersWhole (note, plain, patch, sounding) = comparedNote (note, plain, patch, \(heard, _) => noteSounds (heard, sounding))

// [DAW-PATCH-HEARD] A cable pulled out while rewiring leaves that input hearing silence. The note still renders
// at its full length, a mixer with one input unplugged still passes the other, and a patch with nothing
// reaching its output is a silent track. None of them refuses the note, so none of them stops the song.
unpluggedJourney (keys, route) =
    note = beamed (60, 0.0, 1.0, 1.0)
    pulled = route(cables = filterList (route.cables, \c => c.destination != 2))
    orphan = route(cables = [])
    half = route(nodes = listAppend route.nodes (piece (9, "mixer", [])), cables = [cabled (1, 0, 9, 0), cabled (9, 0, 2, 0), cabled (2, 0, 3, 0)])
    forEachList ([{ note = note, routing = pulled, sounding = false }, { note = note, routing = orphan, sounding = false }, { note = note, routing = half, sounding = true }, { note = beamed (40, 3.0, 1.5, 0.5), routing = half, sounding = true }], \row => rendersWhole (row.note, keys.instrument, daw::PatchInstrument(routing = row.routing), row.sounding))

strayJourney () =
    keys = keysTrack ()
    match keys.instrument
        daw::PatchInstrument route =>
            stray = strayed route
            succeeds (daw::PatchVoices::patched (beamed (60, 0.0, 1.0, 1.0), stray), \graph =>
                expect (length graph.nodes, 5)
                expect (length graph.cables, 3))
            heardAlike (beamed (69, 0.0, 0.25, 0.5), keys.instrument, daw::PatchInstrument(routing = stray))
            heardAlike (beamed (40, 3.0, 1.5, 1.0), keys.instrument, daw::PatchInstrument(routing = stray))
            unpluggedJourney (keys, route)
        _ => expect (false, true)

journeyTest ("a module left unwired in the patch is silent, an unplugged input hears silence, and every note still renders", strayJourney)

// [DAW-PROJECT-PATCH] Save a changed graph on its track, then play the same note bindings from the reopened project.
projectPatchJourney () =
    note = beamed (72, 32.0, 0.5, 0.25)
    original = keysTrack ()
    track = original(notes = [note], pan = -0.25)
    song = timeline [bellTrack (), track]
    succeeds (daw::TrackPatches::patch track, \graph =>
        patchPlays (track, beamed (72, 0.0, 1.0, 1.0), \heard => settled (heard, 1, "frequency", octaveAbove 72.0))
        settled (graph, 1, "frequency", octaveAbove 60.0)
        tone = synth::Components::sine (1, synth::Waves::midiFrequency 60.0 * 3.0)
        amp = synth::Components::gain (2, 0.75)
        valid (synth::Patches::built ([tone, amp, synth::Components::delay (7, 128), synth::Components::output 3], [flowRoute (1, 2, 0), flowRoute (2, 7, 0), flowRoute (7, 3, 0)]), \edit =>
            succeeds (daw::PatchRecords::stored (track, edit), \next =>
                succeeds (daw::Projects::replaced (song, 1, next), \changed =>
                    succeeds (synth::Outcomes::carried (daw::SongFiles::encode changed, daw::SongFiles::decode), \opened =>
                        expect (structuralEquals (opened, changed), true)
                        trackAt (opened, 0, \other => expect (structuralEquals (other, bellTrack ()), true))
                        trackAt (opened, 1, \voice =>
                            expect (structuralEquals (voice.notes, [note]), true)
                            expect (voice.pan, -0.25)
                            match voice.instrument
                                daw::PatchInstrument route =>
                                    expect (route.attack, 0.01)
                                    expect (route.release, 0.1)
                                    succeeds (daw::PatchVoices::patched (note, route), \heard =>
                                        settled (heard, 1, "frequency", synth::Waves::midiFrequency 72.0 * 3.0)
                                        settled (heard, 2, "gain", 0.1875)
                                        expect (structuralEquals (heard.cables, edit.cables), true))
                                _ => expect (false, true)))))))
    succeeds (daw::TrackPatches::patch (bellTrack ()), \originalGraph =>
        bell = bellTrack ()
        moved = daw::NodePosition(layoutNode = 1, layoutX = 227.5, layoutY = 314.25)
        deleted = daw::NodePosition(layoutNode = 99, layoutX = 999.0, layoutY = 0.0)
        succeeds (daw::PatchRecords::savedAt (song, 0, originalGraph, [moved, deleted]), \layout =>
            succeeds (synth::Outcomes::carried (daw::SongFiles::encode layout, daw::SongFiles::decode), \reopened =>
                trackAt (reopened, 0, \savedBell => expect (structuralEquals (savedBell, bell(positions = [moved])), true))
                trackAt (reopened, 1, \keys => expect (structuralEquals (keys, track), true)))))

// The note played through `track`'s patch, as its graph sounds it.
patchPlays (track, note, check) = succeeds (daw::PatchVoices::patched (note, daw::TrackPatches::routing track.instrument), check)

projectPortsJourney () =
    first = synth::Components::withOption (synth::Components::sine (11, 261.0), "waveform", "Waveform", 3.0, 2.0)
    output = synth::Components::stereoOutput 16
    nodes = [first, synth::Components::modulatedLowpass (12, 1800.0, 0.707), synth::Components::lfo (13, 1.7), synth::Components::stereo 14, synth::Components::modulatedGain (15, 2, 0.37), output, synth::Components::midiNote (17, 68.0, 0.6, 256.0), synth::Components::spectral (18, 128, 16, 2.0), synth::Components::downmix 19, synth::Components::pitchShifter (20, 128, 7.0, 25.0), synth::Components::spectral (21, 128, 16, 6.0)]
    routes = [flowRoute (11, 12, 0), flowRoute (13, 12, 1), flowRoute (12, 14, 0), flowRoute (14, 15, 0), flowRoute (13, 15, 1), flowRoute (15, 16, 0)]
    valid (synth::Patches::built (nodes, routes), \graph =>
        withSavedPatch (graph, \changed =>
            succeeds (synth::Outcomes::carried (daw::SongFiles::encode changed, daw::SongFiles::decode), \opened =>
                trackAt (opened, 0, \track =>
                    routing = daw::TrackPatches::routing track.instrument
                    expect (mapList (filterList (routing.nodes, \n => n.identity >= 20), \n => n.component), ["pitchShifter", "spectral"]))
                reopenedPatch (opened, graph)
                trackAt (opened, 0, \track => patchPlays (track, beamed (72, 0.0, 1.0, 1.0), \higher =>
                    settled (higher, 11, "frequency", 522.0)
                    settled (higher, 13, "frequency", 1.7))))))

// The project's first track reopens as the `graph` it saved.
reopenedPatch (opened, graph) = succeeds (daw::TrackPatches::picked (opened, 0), \again => expect (structuralEquals (again, graph), true))

// A grain cloud on the built-in sample saves an empty asset and reopens as the same graph; one naming a
// missing WAV says why the track cannot open.
projectGrainJourney () =
    cloud = synth::Components::granular (21, daw::PatchVoices::builtinSample (), 24, 3)
    valid (synth::Patches::built ([cloud, synth::Components::stereoOutput 22], [flowRoute (21, 22, 0)]), \graph =>
        patchCodec (graph, \source => sourceContains (source, [{ text = "\"component\":\"grainCloud\"", wanted = true }, { text = "\"asset\":\"\"", wanted = true }, { text = "\"module\"", wanted = false }])))
    lost = sourced ("grainCloud", 1, "/nonexistent/osprey-grain.wav")
    lostTrack = patchTrack ("lost", [lost], [], 0.1)
    encoded ((timeline [lostTrack]), \source => expect (contains source "\"asset\":\"/nonexistent/osprey-grain.wav\"", true))
    match daw::TrackPatches::patch lostTrack
        Error _ => expect (true, true)
        Success _ => expect ("an error", "a missing sample")

// A patch's one node: `component`, struck at `seed`, reading `asset`.
sourced (component, seed, asset) = daw::PatchNode(identity = 1, component = component, size = 0, seed = seed, asset = asset, settings = [])

// [SYNTH-GRAPH-CHANNELS] A mixer saved on a track keeps its channel width and both input gains through the
// project codec and reopens patched at them; an older project's size-less mixer reopens mono at unity.
projectMixJourney () =
    wide = synth::Components::mix (1, 8, 0.25, 0.75)
    nodes = [synth::Components::sine (3, 440.0), synth::Components::panner (4, 8, -0.4), wide, synth::Components::routeChannels (5, 8, [0]), synth::Components::output 2]
    wires = [flowRoute (3, 4, 0), flowRoute (4, 1, 0), flowRoute (4, 1, 1), flowRoute (1, 5, 0), flowRoute (5, 2, 0)]
    valid (synth::Patches::built (nodes, wires), \graph =>
        withSavedPatch (graph, \changed =>
            mixerReopened (changed, 8, 0.25, 0.75)))
    legacy = piece (1, "mixer", [])
    track = keysTrack ()
    prior = daw::TrackPatches::routing track.instrument
    older = track(instrument = daw::PatchInstrument(routing = prior(nodes = [legacy], cables = [])))
    mixerReopened (timeline [older], 0, 1.0, 1.0)

mixerReopened (project, storedWidth, first, second) =
    use source <- encoded (project)
    sourceContains (source, [{ text = "\"component\":\"mixer\"", wanted = true }])
    use opened <- decoded (source)
    use track <- trackAt (opened, 0)
    routing = daw::TrackPatches::routing track.instrument
    reads (listGet (ofKind ("mixer", routing.nodes)) 0, \saved =>
        expect (saved.size, storedWidth)
        match storedWidth == 0
            true => expect (length saved.settings, 0)
            false =>
                expect (mapList (saved.settings, \s => s.key), ["firstGain", "secondGain"])
                expect (mapList (saved.settings, \s => s.value), [first, second])
                forEachList (saved.settings, \s => expect (s.follow, daw::Constant)))
    use heard <- succeeds (daw::TrackPatches::patch track)
    match storedWidth > 0
        true =>
            settled (heard, 4, "pan", -0.4)
            valid (synth::Graphs::node (heard, 4), \panner => expect (widths panner.outputs, [storedWidth]))
        false => expect (length (ofKind ("panner", routing.nodes)), 0)
    settled (heard, 1, "firstGain", first)
    settled (heard, 1, "secondGain", second)
    use n <- valid (synth::Graphs::node (heard, 1))
    lengths (n.inputs, 2, n.outputs, 1)
    forEachList (listConcat n.inputs n.outputs, \p => expect (p.channels, ui::Pick::either (storedWidth == 0, 1, storedWidth)))

// The patch nodes that are `kind` of module.
ofKind (kind, nodes) = filterList (nodes, \n => n.component == kind)

journeyTest ("the project JSON reopens the edited patch, its note bindings, track mix and timeline together", \() =>
    projectPatchJourney ()
    projectPortsJourney ()
    projectGrainJourney ()
    projectFormulaJourney ()
    projectMixJourney ())

// [DAW-PROJECT] One project file holds the timeline, each track's mix and each track's patch: a saved project
// reads back to the same notes, routing and patch; mix edits are checked; the transport plays an excerpt.
scored track = track(notes = [beamed (60, 0.0, 1.0, 0.5), beamed (64, 4.0, 2.5, 0.75), beamed (67, 8.5, 0.25, 1.0), beamed (72, 12.0, 1.0, 0.25)])

song () = timeline [scored (bellTrack ()), scored (keysTrack ()), pluckTrack ()]

trackAt (arrangement, index, check) = reads (listGet arrangement.tracks index, check)

starts voice = mapList (voice.notes, \note => note.start)

// The score's four notes start on beats 0, 4, 8.5 and 12.
scoredStarts voice = expect (starts voice, [0.0, 4.0, 8.5, 12.0])

mixedTo (voice, gain, pan) =
    expect (voice.gain, gain)
    expect (voice.pan, pan)

encoded (arrangement, check) = succeeds (daw::SongFiles::encode arrangement, check)

sourceContains (source, snippets) = forEachList (snippets, \snippet => expect (contains source snippet.text, snippet.wanted))

decoded (text, check) = succeeds (daw::SongFiles::decode text, check)

withSavedPatch (graph, check) = succeeds (daw::PatchRecords::saved (timeline [keysTrack ()], 0, graph), check)

patchCodec (graph, inspect) = withSavedPatch (graph, \changed => encoded (changed, \source =>
    inspect source
    decoded (source, \opened => reopenedPatch (opened, graph))))

roundTrip arrangement = encoded (arrangement, \text => decoded (text, \back =>
    encoded (back, \again => expect (again, text))
    expect (back.title, "Bridge")
    countOf (back.tracks, 3)
    trackAt (back, 1, \voice => scoredStarts voice)
    succeeds (daw::TrackPatches::picked (back, 1), \graph =>
        expect (length graph.cables, 2)
        keysSaved graph)))

mixJourney arrangement =
    succeeds (daw::Projects::mixed (arrangement, 1, 1.5, -0.6), \edited =>
        trackAt (edited, 1, \voice => mixedTo (voice, 1.5, -0.6))
        forEachList ([0, 2], \index => trackAt (edited, index, \voice => mixedTo (voice, 1.0, 0.0)))
        roundTrip edited)
    forEachList ([{ track = 1, gain = 4.5, pan = 0.0, why = "Gain must be 0 to 4 and pan -1 to 1." }, { track = 1, gain = 1.0, pan = -1.5, why = "Gain must be 0 to 4 and pan -1 to 1." }, { track = 3, gain = 1.0, pan = 0.0, why = "There is no track 4." }], \row => failsWith (daw::Projects::mixed (arrangement, row.track, row.gain, row.pan), row.why))

excerptJourney arrangement =
    cut = daw::Projects::excerpt (arrangement, 4.0, 8.0)
    trackAt (cut, 1, \voice => expect (starts voice, [0.0, 4.5]))
    trackAt (cut, 2, \voice => expect (length voice.notes, 0))
    expect (length (daw::Projects::excerpt (arrangement, 13.0, 4.0)).tracks, 3)

// [DAW-TRANSPORT-PLAYHEAD] A ruler tap moves Play's start marker to the tapped bar and keeps the track.
// A tap on the lanes at `x`, `y` is the lane `action`, or the test fails.
laneAction (editor, x, y, action) = succeeds (synth::TimelineView::laneAt (editor, x, y), \got => expect (got, action))

// A lane tap at `x`, `y` that moves the playhead to `bar`.
laneSetsBar (editor, x, y, bar) =
    laneAction (editor, x, y, synth::MoveStart(bar = bar))
    moved = (synth::DawSession::started (editor, bar)).stepStore
    expect ([moved.playStart, moved.track], [bar, editor.track])

mixFromRow (editor, action, path) = match action
    synth::AdjustMix index gain pan =>
        expect (index, 1)
        expect (gain, 2.0)
        expect (pan, 0.0)
        changed = (synth::DawSession::adjusted (editor, index, gain, pan)).stepStore
        expect (changed.track, 1)
        fresh = synth::DawSession::loaded (editor, path)
        trackAt (fresh.song, index, \voice => mixedTo (voice, gain, pan))
        before = synth::DawSession::picked (fresh, index)
        note = before(selectedNote = 1)
        after = (synth::DawSession::velocity (note, 0.35)).stepStore
        readBack = synth::DawSession::loaded (after, path)
        trackAt (readBack.song, index, \voice =>
            mixedTo (voice, gain, pan)
            expect (mapList (voice.notes, \n => n.velocity), [0.5, 0.35, 1.0, 0.25])
            scoredStarts voice)
        failsWith (daw::Projects::velocity (readBack.song, index, 1, 1.01), "Velocity must be between 0 and 1.")

    _ => expect (false, true)

saveJourney arrangement =
    path = "${outputFolder ()}/project.json"
    outputMade ()
    succeeds (daw::Projects::saved (arrangement, path), \written => succeeds (readFile written, \source => decoded (source, \back => encoded (back, \again => encoded (arrangement, \text => expect (again, text))))))
    failsWith (daw::Projects::saved (arrangement, "target/it's.json"), "A project path cannot contain a quote.")
    old = synth::EditorState::initial ()
    reopened = synth::DawSession::loaded (old(patchTrack = 1), path)
    expect (reopened.patchTrack, -1)
    selected = synth::DawSession::picked (reopened, 1)
    patch = (synth::DawSession::shown (selected, synth::PatchPage)).stepStore
    expect (patch.patchTrack, 1)
    succeeds (daw::TrackPatches::picked (arrangement, 1), \graph => expect (structuralEquals (patch.graph, graph), true))
    row = Semantics::element (synth::MixView::access reopened, "Mix track 2")
    center = Semantics::point (row, 0.5)
    succeeds (synth::MixView::rowAt (reopened, 242.5, center.pointY), \action => mixFromRow (reopened, action, path))

projectJourney () =
    roundTrip (song ())
    mixJourney (song ())
    excerptJourney (song ())
    saveJourney (song ())
    hosted timingJourney

timingJourney () =
    path = "${outputFolder ()}/timing.json"
    succeeds (daw::Projects::saved (song (), path), \_ => expect (true, true))
    session = editorLaunched ["--song", path]
    editing = studioTap (session, "Edit BPM")
    invalid = Drive::press (Drive::choose (editing, "BPM", "401"), "Apply timing")
    expect ((Drive::holding invalid).song.tempo, (Drive::holding session).song.tempo)
    changed = Drive::press (Drive::choose (Drive::choose (invalid, "BPM", "96.5"), "Time signature", "6/8"), "Apply timing")
    stored = synth::DawSession::loaded (Drive::holding changed, path)
    expect (stored.song.tempo, 96.5)
    expect ([stored.song.meterTop, stored.song.meterBottom], [6, 8])
    expect (synth::DawSession::rangeStart (stored(playStart = 2)), 6.0)
    cancelled = Drive::press (Drive::choose (studioTap (changed, "Edit meter"), "Time signature", "3/4"), "Cancel")
    expect ((Drive::holding cancelled).song.meterTop, 6)

journeyTest ("a project file saves and reopens its notes, mix and patches; mix edits are checked", projectJourney)

// [DAW-TRANSPORT-LIVE] Play is real time: it writes the project as it stands, edits included, beside the renderer
// and at once streams the range from the start marker to the end marker into the audio device. Nothing renders
// first. The playhead follows the frames the device has sounded, Loop repeats the range, and Stop cancels it.
transportRoot () = "${outputFolder ()}/transport"

asked step = mapList (step.requests, \r => r.capability)

ranWith (step, executable, arguments) = match asked step
    [ui::Run ran given _ _ _ _] =>
        expect (ran, executable)
        expect (given, arguments)
    _ => expect (length step.requests, 1)

said (step, ticket, message) =
    expect (step.stepStore.songTicket, ticket)
    expect (step.stepStore.message, message)

// `path` as it reads, or "unread" where nothing is there.
fileRead (path) = readFile path ?: "unread"

// The project at `path` is the encoding of `arrangement`.
savedAs (arrangement, path) = encoded (arrangement, \text => expect (readFile path ?: "", text))
rendererSaid output = Success(value = "{\"status\":0,\"stdout\":\"${output}\",\"stderr\":\"\"}")

liveFolder () = "${transportRoot ()}/bin/song/live"

// The ticket of the song's live stream.
liveTicket () = "daw-song:live:${liveFolder ()}"

// One shell pipeline, renderer to audio device, and the frame clock on; the old receipt is emptied.
streams (step, message, from, beats, mode) =
    said (step, liveTicket (), message)
    match asked step
        [ui::Run ran given _ _ _ _, ui::Animate on] =>
            expect (ran, "/bin/sh")
            expect (length given, 9)
            expect (listGet given 0 ?: "", "-c")
            // [DAW-RENDER-MASTER] Play makes no note ahead of the graph: no maker runs beside the stream.
            command = listGet given 1 ?: ""
            expect (contains command " warm ", false)
            expect (contains command "\"$3/controls\";", true)
            expect (mapList ([2, 3, 4, 5, 6, 7, 8], \index => listGet given index ?: ""), ["${transportRoot ()}/bin/worker", "${transportRoot ()}/bin/daw", "${liveFolder ()}/project.json", liveFolder (), from, beats, mode])
            expect (on, true)
        _ => expect (length step.requests, 2)
    expect (synth::DawSession::phase step.stepStore, "Playing")
    expect (step.stepStore.playClock, 0.0)
    expect (fileRead "${liveFolder ()}/played.json", "")

// Play streams bars 2–4 live: from beat 4 to beat 9, once.
streamsBars24 (step) = streams (step, playingBars24, "4.0", "9.0", "live")

// What the audio device answers after a block: frames accepted, frames finished, and whether it runs.
deviceSaid (accepted, returned, running) = "{\"status\":0,\"acceptedFrames\":${accepted},\"returnedFrames\":${returned},\"queuedFrames\":${satSub accepted returned},\"channels\":2,\"emptyCallbacks\":0,\"running\":${running}}"

// The editor one display frame of `elapsed` seconds after the device answered `text`.
framedAfter (editor, text, elapsed) =
    _answered = writeFile "${liveFolder ()}/played.json" text
    step = synth::DawSession::framed (editor, elapsed)
    expect (length step.requests, 0)
    step.stepStore

heardAt (editor, beat, seconds) =
    expect (editor.playBeat, beat)
    expect (editor.playClock, seconds)

// The display frame `elapsed` after the device answered, with the playhead it leaves there.
advanced (editor, accepted, returned, elapsed, beat, seconds) =
    later = framedAfter (editor, deviceSaid (accepted, returned, "true"), elapsed)
    heardAt (later, beat, seconds)
    later

// [DAW-TRANSPORT-FOLLOW] 120 bpm at 48 kHz: the playhead waits for the device, runs with the frame clock, never
// passes what the device was given, never falls behind what it finished, and stops at the end marker.
followJourney playing =
    heardAt (playing, 4.0, 0.0)
    heardAt (framedAfter (playing, "", 0.5), 4.0, 0.0)
    heardAt (framedAfter (playing, deviceSaid (8192, 0, "false"), 0.5), 4.0, 0.0)
    quarter = advanced (playing, 48000, 0, 0.25, 4.5, 0.25)
    waiting = advanced (quarter, 48000, 0, 5.0, 6.0, 1.0)
    caught = pagedTo (waiting, 144000, 96000, 0.0, 8.0, 2.0, 1.0)
    paged = pagedTo (caught, 480000, 196800, 0.0, 12.2, 4.1, 3.0)
    _ended = advanced (paged, 480000, 480000, 0.0, 13.0, 10.0)
    expect (paged.rollBar, 1)
    expect (paged.songTicket, liveTicket ())

// The display frame `elapsed` after the device answered, the playhead at `beat` and `seconds`, on roll page `page`.
pagedTo (editor, accepted, returned, elapsed, beat, seconds, page) =
    later = advanced (editor, accepted, returned, elapsed, beat, seconds)
    expect (synth::TimelineGeometry::rollPage (later.playBeat, 1.0, 4.0), page)
    later

// [DAW-TRANSPORT-LOOP] Loop repeats the range: ten beats into a nine-beat loop is its second beat.
loopJourney ready =
    on = synth::DawSession::looped ready
    loopSet (on, "Loop on: Play repeats from the start marker to the end marker.", true)
    looping = synth::DawSession::play on.stepStore
    streams (looping, "Looping bars 2–4 of Bridge.", "4.0", "9.0", "loop")
    heardAt (framedAfter (looping.stepStore, deviceSaid (480000, 240000, "true"), 0.0), 5.0, 5.0)
    said (synth::DawSession::looped looping.stepStore, liveTicket (), "Stop first to change Loop.")
    off = synth::DawSession::looped on.stepStore
    loopSet (off, "Loop off: Play runs once to the end marker.", false)

// Loop switched on or off: the step says `message`, and the song loops or not.
loopSet (step, message, looping) =
    said (step, "", message)
    expect (step.stepStore.looping, looping)

// The range the editor would play: its start marker, then its end marker.
rangeIs (editor, from, to) =
    expect (synth::DawSession::rangeStart editor, from)
    expect (synth::DawSession::rangeEnd editor, to)

// [DAW-TRANSPORT-RANGE] The end marker starts at the song's end (beat 13); moved to a bar line after the start
// marker it ends Play there; at or before the start marker, or past the song, it means the song's end again.
rangeJourney ready =
    rangeIs (ready, 4.0, 13.0)
    shorter = synth::DawSession::ended (ready, 3)
    said (shorter, "", "Play runs bars 2–3.")
    expect (synth::DawSession::rangeEnd shorter.stepStore, 12.0)
    streams (synth::DawSession::play shorter.stepStore, "Playing bars 2–3 of Bridge.", "4.0", "8.0", "live")
    forEachList ([1, 0, 9], \bar => expect (synth::DawSession::rangeEnd (synth::DawSession::ended (ready, bar)).stepStore, 13.0))
    short = shorter.stepStore
    expect ([synth::DawSession::rangeEnd (short(playStart = 2)), synth::DawSession::rangeEnd (short(playStart = 3))], [12.0, 13.0])
    // Either marker is taken anywhere down its line, in the ruler or the lanes, and moves alone.
    forEachList ([
    { x = 1092.0, y = 212.0, action = synth::MoveEnd(bar = 3) }, { x = 1092.0, y = 200.0, action = synth::MoveEnd(bar = 3) },
    { x = 1090.0, y = 400.0, action = synth::MoveEnd(bar = 3) }, { x = 473.0, y = 200.0, action = synth::MoveStart(bar = 1) },
    { x = 475.0, y = 400.0, action = synth::MoveStart(bar = 1) }], \tap => laneAction (ready, tap.x, tap.y, tap.action))
    laneSetsBar (ready, 600.0, 200.0, 1)
    expect ([synth::TimelineView::startAt (ready, 198.0), synth::TimelineView::startAt (ready, 1092.0), synth::TimelineView::startAt (short, 1092.0)], [0, 3, 2])
    later = synth::DawSession::started (short, 2)
    said (later, "", "Play runs bars 3–3.")
    rangeIs (later.stepStore, 8.0, 12.0)
    earlier = synth::DawSession::started (short, 0)
    rangeIs (earlier.stepStore, 0.0, 12.0)
    expect ([synth::TimelineView::endAt (ready, 198.0), synth::TimelineView::endAt (ready, 1092.0)], [2, 3])
    expect ([synth::TimelineGeometry::endBar (9.9, 1.0, 4.0), synth::TimelineGeometry::endBar (10.0, 1.0, 4.0)], [2.0, 3.0])
    expect ([synth::TimelineGeometry::grabs (100.0, 106.0), synth::TimelineGeometry::grabs (100.0, 106.5)], [true, false])
    said (synth::DawSession::play (ready(playStart = 4)), "", "The start marker is at the song's end; move it back to play.")
    playing = synth::DawSession::play ready
    said (synth::DawSession::ended (playing.stepStore, 3), liveTicket (), "Stop first to move the end marker.")
    said (synth::DawSession::started (playing.stepStore, 0), liveTicket (), "Stop first to move the start marker.")

gainOf (editor, index) = match listGet editor.song.tracks index
    Error _ => -1.0
    Success voice => voice.gain

// [DAW-MIX-DRAG] A held fader moves the track in memory on every pointer move and writes the project once, on
// release, as one undo step.
faderJourney opened =
    ready = opened(page = synth::TimelinePage)
    faderHeld (ready, false)
    // On the patch page a gesture is a card drag, never a held fader.
    faderHeld (synth::DawSession::slid (opened(page = synth::PatchPage), 1, 2.0, 0.5), false)
    before = gainOf (ready, 1)
    held = synth::DawSession::slid (ready, 1, 2.0, 0.5)
    faderHeld (held, true)
    faderIs (held, 2.0)
    expect (length held.past, length ready.past)
    expect (held.revision, satAdd ready.revision 1)
    moved = synth::DawSession::slid (held, 1, 3.0, 0.5)
    faderIs (moved, 3.0)
    expect (length moved.gesture, 1)
    // A value out of range leaves the fader where it was, still held.
    wild = synth::DawSession::slid (moved, 1, 9.0, 0.5)
    faderIs (wild, 3.0)
    faderHeld (wild, true)
    released = synth::DawSession::dropped moved
    settled = released.stepStore
    faderHeld (settled, false)
    faderIs (settled, 3.0)
    expect (length settled.past, satAdd (length ready.past) 1)
    expect (contains (readFile settled.songPath ?: "") "\"gain\":3.0", true)
    undone = synth::EditorHistory::undo settled
    faderIs (undone, before)

// Track 1's fader gain, and whether its fader is held.
faderIs (editor, gain) = expect (gainOf (editor, 1), gain)

faderHeld (editor, held) = expect (synth::DawSession::holding editor, held)

// After a mix edit Play streams the edited snapshot.
remixed (ready, louder) =
    edited = ready(song = louder)
    streamsBars24 (synth::DawSession::play edited)
    savedAs (louder, "${liveFolder ()}/project.json")

songFolder () = "${transportRoot ()}/bin/song/song"

// The ticket of the song's render.
renderTicket () = "daw-song:render:${songFolder ()}"

// [DAW-RENDER] The whole project renders to its own folder: refused while busy, only real audio counts, unchanged audio is kept.
// `editor` starts rendering the whole song: the render ticket is asked for and the message says so.
renderStarted (editor) =
    step = synth::DawSession::renderSong editor
    renderAnew step
    step

// The step of a render of the whole song starting.
renderAnew (step) = said (step, renderTicket (), renderingAllOfBridge)

// `count` RIFF headers back to back: a WAV too short, header-only or truncated.
riff (count) = join (mapList (toList (range (0, count)), \_ => "RIFF")) ""

// The song folder's WAV written as `content`, then `check`ed.
wavStub (content, check) = succeeds (writeFile "${songFolder ()}/song.wav" content, \_ => check ())

// FerroUI publishes the renderer transcript in the requested slice and only status/stderr in the receipt.
rendererTranscript (first, transcript, expected) =
    handle ui::Slices
        fetch key => ui::Pick::either (key == "studio-song-report", transcript, "")
    said (synth::DawSession::completed (first.stepStore, renderTicket (), Success(value = "{\"status\":0,\"stderr\":\"\"}")), "", expected)

// The copy runs through the native process callback.
fixtureCopyEvent (_pid, _kind, _text) = print ""

renderSongJourney ready =
    // A previous run's finished render would otherwise count as this project's audio.
    _made = makeDir (songFolder ())
    _cleared = writeFile "${songFolder ()}/song.wav" ""
    forEachList ([{ index = 0, page = synth::TimelinePage }, { index = 1, page = synth::PatchPage }, { index = 2, page = synth::MixPage }], \row => expect (synth::Header::songAction (ready, row.index), synth::ShowPage(page = row.page)))
    said (synth::DawSession::renderSong (ready(renderer = "")), "", noRenderer)
    first = renderStarted ready
    ranWith (first, "${transportRoot ()}/bin/daw", ["${songFolder ()}/project.json", songFolder ()])
    expect (fileSize "${songFolder ()}/song.wav" ?: -1, 0)
    savedAs (song (), "${songFolder ()}/project.json")
    expect (synth::DawSession::phase first.stepStore, "Rendering…")
    said (synth::DawSession::renderSong first.stepStore, renderTicket (), theSongIsAlready)
    said (synth::DawSession::play first.stepStore, renderTicket (), theSongIsAlready)
    said (synth::DawSession::completed (first.stepStore, renderTicket (), rendererSaid "daw: refused"), "", "Rendering failed: daw: refused")
    rendererTranscript (first, "daw: Bridge\ndaw: unknown patch setting.\n", "Rendering failed: daw: unknown patch setting.")
    rendererTranscript (first, "", "Rendering failed: The renderer produced no audio.")
    wavStub (riff 64, \() => expect (true, true))
    rendererTranscript (first, "daw: interrupted", "Rendering failed: daw: interrupted")
    renderAnew (synth::DawSession::renderSong ready)
    hat = signalflow::App::fromRepository "src/studio/tracks/samples/808-hat.wav"
    succeeds (spawnProcess "cp ${hat} '${songFolder ()}/song.wav'" fixtureCopyEvent, \process =>
        expect (awaitProcess process, 0)
        _closed = cleanupProcess process
        expect ((fileSize "${songFolder ()}/song.wav" ?: 0) > 44, true))
    done = synth::DawSession::completed (first.stepStore, renderTicket (), rendererSaid "daw: wrote it")
    said (done, "", "Rendered ${songFolder ()}/song.wav.")
    expect (length done.requests, 0)
    said (synth::DawSession::renderSong ready, "", "${songFolder ()}/song.wav is already this project.")
    // [DAW-PAGES] A render cancelled mid-way leaves an empty, header-only or truncated WAV beside the same project:
    // the next render makes it again rather than keeping it.
    forEachList (["", "RIFF", riff 11], \stub => wavStub (stub, \() => renderAnew (synth::DawSession::renderSong ready)))
    said (synth::DawSession::stop first.stepStore, "", "Stopped.")

// A song whose last note ends on a bar line: the end of the ruler is that last bar, never the empty one after it,
// and Play and Stop are the transport, coloured apart from the page tabs.
barLined track = track(notes = [beamed (60, 0.0, 1.0, 0.5), beamed (64, 12.0, 4.0, 0.5)])

labelled (editor, label) = filterList (synth::TimelineView::headerAreas editor, \a => a.accessLabel == label)

firstTrace editor = length (listGet editor.laneTraces 0 ?: [])

// Zoomed by `factor`, with the lane zoom it lands on checked.
zoomedTo (editor, factor, zoom) =
    zipped = synth::TimelineView::zoomedBy (editor, factor)
    expect (zipped.laneZoom, zoom)
    zipped

// Zoomed by `factor`, with the lane zoom, the beats and the lane it lands on checked.
zoomShows (editor, factor, zoom, beats, lane) =
    zipped = zoomedTo (editor, factor, zoom)
    expect (synth::TimelineView::shownBeats zipped, beats)
    expect (zipped.laneStart, lane)
    zipped

// [DAW-TIMELINE-ZOOM] Zoom changes which beats the lanes show, about the playhead, and nothing else: taps, traces
// and the ruler follow it; the song, the playhead, the track and the undo history stay. Moving the playhead out
// of view brings the lanes with it.
zoomJourney lined =
    at = lined(rollBar = 1, playStart = 1, laneTraces = synth::TimelineView::traces (lined.song, 1.0, 0.0, 0))
    expect (synth::TimelineView::shownBeats at, 16.0)
    expect (synth::TimelineView::shownFrom at, 0.0)
    closer = zoomShows (at, 2.0, 2.0, 8.0, 2.0)
    expect (synth::TimelineView::shownFrom closer, 2.0)
    expect (closer.rollBar, 1)
    expect (closer.track, at.track)
    expect (length closer.past, length at.past)
    expect (daw::Arrangements::beats closer.song, 16.0)
    // Beats 2 to 10 are in view: both notes lie outside, so the lane draws no trace, and a tap reads the new scale.
    forEachList ([{ x = 205.0, bar = 0 }, { x = 645.0, bar = 1 }, { x = 1085.0, bar = 2 }], \point =>
        laneSetsBar (closer, point.x, 200.0, point.bar))
    picksTrack (closer, 1085.0, 235.0, 0, 2)
    // The closest zoom is one beat across the lanes, still about the playhead; the widest is the whole song.
    closest = zoomShows (closer, 100.0, 16.0, 1.0, 3.75)
    wider = zoomedTo (closer, 0.5, 1.0)
    expect ((synth::TimelineView::zoomedBy (wider, 0.5)).laneZoom, 1.0)
    fitted = zoomedTo (closest, 0.0, 1.0)
    expect (fitted.rollBar, 1)
    // The last note starts at beat 12: once the lanes reach it, its trace is drawn, cut at the right edge.
    withLastNote = synth::TimelineView::following (closer(playStart = 3))
    expect ([firstTrace at, firstTrace closer, firstTrace wider, firstTrace withLastNote], [4, 0, 4, 2])
    expect ([wider.laneStart, fitted.laneStart, withLastNote.laneStart], [0.0, 0.0, 8.0])
    expect (mapList ([closer(playStart = 0), closer(playStart = 1), at], \editor => (synth::TimelineView::following editor).laneStart), [0.0, 4.0, 0.0])
    expect (synth::TimelineGeometry::laneX (6.0, 2.0, 8.0), 645.0)
    expect ([synth::TimelineGeometry::laneEdge 100.0, synth::TimelineGeometry::laneEdge 2000.0], [198.0, 1092.0])
    forEachList ([{ factor = 1.0, zoom = 0.5, beats = 16.0, want = 1.0 }, { factor = 4.0, zoom = 1.25, beats = 0.0, want = 1.0 }, { factor = 4.0, zoom = 1.25, beats = 16.0, want = 5.0 }], \row => expect (synth::TimelineGeometry::zoomed (row.factor, row.zoom, row.beats), row.want))
    // The ruler: bars with every fourth numbered, then every bar, then beats, then sixteenths.
    forEachList ([[65.0, 4.0, 16.0], [64.0, 4.0, 4.0], [17.0, 4.0, 4.0], [16.0, 1.0, 4.0], [5.0, 1.0, 4.0], [4.0, 0.25, 1.0], [1.0, 0.25, 1.0]], \row =>
        expect (synth::TimelineGeometry::rulerStep (listGet row 0 ?: 0.0, 4.0, 1.0), listGet row 1 ?: 0.0)
        expect (synth::TimelineGeometry::rulerMajor (listGet row 0 ?: 0.0, 4.0, 1.0), listGet row 2 ?: 0.0))
    expect ([synth::TimelineGeometry::onDivision (8.0, 4.0), synth::TimelineGeometry::onDivision (9.0, 4.0)], [1.0, 0.0])
    expect (synth::TimelineGeometry::beatInBar (6.0, 4.0, 1.0), 3.0)
    expect (synth::TimelineGeometry::rulerBeat (2.0, 1.0, 3.0), 5.0)
    expect (synth::TimelineGeometry::rulerCount (8.0, 1.0), 10.0)
    // Every keymap gives the three zoom commands keys.
    forEachList (synth::Keymaps::names, \name => forEachList (["zoomIn", "zoomOut", "zoomFit"], \command => expect (synth::Keymaps::keys (synth::Keymaps::preset name, command) != "", true)))
    keyOf ("Perception Studio", "zoomIn", "Cmd+OemPlus")
    keyOf ("Ableton Style", "zoomFit", "Cmd+D0")
    keyOf ("Logic Style", "zoomOut", "Cmd+Left")

// Maker `worker` of `workers` run on the host's shell.
maker (song, folder, worker, workers) = daw::Shell::hosted (\() => daw::NoteCache::warmed (song, folder, worker, workers, ""))

// How many notes makers `order` of `workers` made in turn; a refused maker counts -1000.
madeBy (song, folder, order, workers) = foldList (order, 0, \(sum, worker) => satAdd sum (maker (song, folder, worker, workers) ?: -1000))

keptNotes dir = length (filterList (listDir dir ?: [], \entry => endsWith entry ".st"))

// [DAW-TRANSPORT-LIVE-SPEED] [DAW-TESTS] Two makers share a song's distinct notes: tracks that sound alike share one
// folder, a repeated note is made once, a second pass makes nothing, a silent track has no folder, a kept note
// reads back as its stereo lanes, and an edited instrument's old folder is swept by maker 0.
makerJourney () =
    folder = "${transportRoot ()}/bin/song/makers"
    _cleared = daw::Shell::hosted (\() => daw::Shell::ran (20, "rm -rf ${daw::Shell::quoted folder}"))
    plucked = barLined (pluckTrack ())
    echoed = plucked(name = "echoed", notes = listAppend plucked.notes (beamed (60, 4.0, 1.0, 0.5)))
    darker = plucked(name = "darker", instrument = daw::PluckInstrument(brightness = 0.3, decay = 0.9))
    song = timeline [plucked, echoed, darker, restTrack ()]
    expect ([madeBy (song, folder, [0, 1], 2), madeBy (song, folder, [1, 0], 2)], [4, 0])
    succeeds (daw::NoteCache::found (song, folder), \dirs =>
        expect (length dirs, 4)
        expect ([(listGet dirs 0 ?: "a") == (listGet dirs 1 ?: "b"), (listGet dirs 0 ?: "a") == (listGet dirs 2 ?: "a"), (listGet dirs 3 ?: "x") == ""], [true, false, true])
        forEachList ([0, 2], \index => expect (keptNotes (listGet dirs index ?: ""), 2))
        succeeds (daw::Arrangements::opened (song, echoed), \play =>
            kept = daw::NoteCache::seeded (listGet dirs 1 ?: "", play, 9223372036854775807)
            expect (length kept.made, 2)
            forEachList (kept.made, \m =>
                expect (length m.chord, 2)
                expect (length (listGet m.chord 0 ?: []) > 0 && length (listGet m.chord 0 ?: []) == length (listGet m.chord 1 ?: []), true))
            expect (structuralEquals (daw::NoteCache::seeded ("", play, 9223372036854775807), play), true))
        brighter = song(tracks = listConcat (synth::Sequences::take (song.tracks, 2)) [darker(instrument = daw::PluckInstrument(brightness = 0.9, decay = 0.9)), restTrack ()])
        expect (madeBy (brighter, folder, [0], 1), 2)
        succeeds (daw::NoteCache::found (brighter, folder), \moved =>
            expect ((listGet moved 2 ?: "") == (listGet dirs 2 ?: ""), false)
            expect (listGet moved 0 ?: "", listGet dirs 0 ?: "a"))
        expect (keptNotes (listGet dirs 2 ?: ""), 0)
        expect (length (filterList (listDir "${folder}/notes" ?: [], \entry => endsWith entry "/")), 2))
    forEachList ([{ worker = 2, workers = 2 }, { worker = -1, workers = 2 }, { worker = 0, workers = 65 }], \bad =>
        failsWith (maker (song, folder, bad.worker, bad.workers), "A maker needs its number, from 0, and the count of makers, at most 64."))

// A track that never sounds, on the pluck's instrument.
restTrack () = freshTrack ("rest", daw::PluckInstrument(brightness = 0.7, decay = 0.9))

// True when a lane press grabs the scrollbar.
scrollPress outcome = match outcome
    Success action => match action
        synth::ScrollLanes _ => true
        _ => false
    Error _ => false

// A press at (`x`, `y`) on the scrollbar puts track `top` first.
scrollsTo (editor, x, y, top) = laneAction (editor, x, y, synth::ScrollLanes(top = top))

// A press at (`x`, `y`) on the lanes picks track `index` at `bar`.
picksTrack (editor, x, y, index, bar) = laneAction (editor, x, y, synth::PickTrack(index = index, bar = bar))

// The names of the tracks the lanes show, first lane first.
laneLabels editor = mapList (synth::TimelineView::laneAccess editor, \a => a.accessLabel)

// [DAW-LAYOUT-FILL] [DAW-TESTS] Ten tracks scroll in seven lanes: a press anywhere on the 217-point bar puts the
// thumb's middle under it, clamped to the first and last page; outside the bar, or with seven tracks or fewer,
// nothing scrolls. The scrolled lanes draw, name and pick the tracks now in view, and a track kept in view moves
// the lanes no further than it must.
scrollJourney lined =
    ten = lined(song = timeline (mapList (toList (range (0, 10)), \i => barLined (freshTrack ("lane ${i}", daw::PluckInstrument(brightness = 0.7, decay = 0.9))))), track = 0, laneTop = 0)
    forEachList ([{ y = 221.0, top = 0 }, { y = 250.0, top = 0 }, { y = 300.0, top = 0 }, { y = 320.0, top = 1 }, { y = 329.5, top = 2 }, { y = 380.0, top = 3 }, { y = 437.9, top = 3 }], \row =>
        forEachList ([1113.0, 1121.0, 1131.9], \x => scrollsTo (ten, x, row.y, row.top)))
    forEachList ([{ x = 1112.9, y = 300.0 }, { x = 1132.0, y = 300.0 }, { x = 1121.0, y = 220.9 }, { x = 1121.0, y = 438.0 }], \point =>
        expect (scrollPress (synth::TimelineView::laneAt (ten, point.x, point.y)), false))
    forEachList ([lined, ten(song = timeline (mapList (toList (range (0, 7)), \_ => pluckTrack ())))], \few =>
        expect (scrollPress (synth::TimelineView::laneAt (few, 1121.0, 300.0)), false))
    expect (laneLabels ten, ["Track 1", "Track 2", "Track 3", "Track 4", "Track 5", "Track 6", "Track 7"])
    down = synth::TimelineView::scrolled (ten, 2)
    expect ([down.laneTop, down.revision], [2, satAdd ten.revision 1])
    expect (length down.laneTraces, 10)
    expect (laneLabels down, ["Track 3", "Track 4", "Track 5", "Track 6", "Track 7", "Track 8", "Track 9"])
    expect ((synth::TimelineView::scrolled (down, 2)).revision, down.revision)
    // The first lane now holds track 3, the last track 9.
    picksTrack (down, 1085.0, 235.0, 2, 3)
    picksTrack (down, 1085.0, 421.0, 8, 3)
    expect ((synth::TimelineView::scrolled (down, 3)).laneTop, 3)
    near (synth::TimelineGeometry::thumbTop (2.0, 10.0), 264.4)
    near (synth::TimelineGeometry::thumbHeight (7.0, 10.0), 151.9)
    forEachList ([{ index = 0, top = 0 }, { index = 1, top = 1 }, { index = 2, top = 2 }, { index = 8, top = 2 }, { index = 9, top = 3 }], \row =>
        expect (synth::TimelineView::keeping (down, row.index), row.top))

barLineJourney ready =
    lined = ready(song = timeline [barLined (pluckTrack ())], track = 0)
    zoomJourney lined
    scrollJourney lined
    expect (daw::Arrangements::beats lined.song, 16.0)
    forEachList ([{ x = 1085.0, bar = 3 }, { x = 1084.0, bar = 3 }, { x = 205.0, bar = 0 }, { x = 428.0, bar = 1 }, { x = 868.5, bar = 3 }], \point => laneSetsBar (lined, point.x, 200.0, point.bar))
    picksTrack (lined, 1085.0, 235.0, 0, 3)
    // [DAW-HEADER] The header holds the page tabs and the transport; every other command is in the menu bar.
    headerLabels (ready, ["Timeline", "Track patch", "Bus routing", "Return to start", "Play"], 1)
    headerLabels (ready, ["Render song", "Open song", "Save project", "Keyboard", "Play bars", "Stop"], 0)
    expect (length (synth::TimelineView::headerAreas ready), 8)
    // The song overview has one column per bar of the song.
    lengths (synth::Header::overview lined.song, 4, synth::Header::overview (timeline []), 1)
    expect (synth::TimelineGeometry::playableBar (-1.0, 16.0, 4.0), 0.0)
    expect (synth::TimelineGeometry::playableBar (8.0, 0.0, 4.0), 0.0)
    // Return to start moves Play's start marker to bar 1 and pages the piano roll there; the track stays.
    headerAction (ready(track = 0), 3, synth::MoveStart(bar = 0))
    returned = (synth::DawSession::started (ready(track = 0, playStart = 3, rollBar = 2), 0)).stepStore
    expect ([returned.playStart, returned.track, returned.rollBar], [0, 0, 0])
    headerAction (ready, 4, synth::PlaySong)

// The header holds each of `labels` exactly `count` times.
headerLabels (editor, labels, count) = forEachList (labels, \label => expect (length (labelled (editor, label)), count))

// The header's control at `index` runs `action`.
headerAction (editor, index, action) = expect (synth::Header::songAction (editor, index), action)

// [DAW-TRANSPORT-STOP-IDLE]
songStopAt editor = synth::EditorView::areaAt (synth::Header::songAreas editor, 1390.0 + synth::Header::shift editor, 100.0)

stopJourney ready =
    idle = ready(playStart = 4, selectedNote = 1)
    stopped = synth::DawSession::stop idle
    expect (stopped.stepStore.playStart, 4)
    expect (stopped.stepStore.selectedNote, 1)
    expect (stopped.stepStore.message, idle.message)
    expect (songStopAt idle, -1)
    live = stopsWhen (idle, "daw-song:live:project")
    expect (songStopAt (synth::DawSession::stop live).stepStore, -1)
    ended = synth::DawSession::completed (live, live.songTicket, rendererSaid "")
    expect (songStopAt ended.stepStore, -1)
    _rendering = stopsWhen (idle, "daw-song:render:project")
    expect (synth::EditorView::toolbarAt (idle, 900.0, 32.0) ?: -1, -1)

// A finished song: the playhead resets, only `asks` stays outstanding, and the phase is Stopped.
halted (step, asks) =
    expect (step.stepStore.playBeat, -1.0)
    expect (asked step, asks)
    expect (synth::DawSession::phase step.stepStore, "Stopped")

// While `ticket` is outstanding the header's Stop is the transport's.
stopsWhen (editor, ticket) =
    busy = editor(songTicket = ticket)
    expect (synth::Header::songAction (busy, songStopAt busy), synth::StopSong)
    busy

// Play refused: the step says `message` and keeps its ticket.
refusedPlay (editor, message) = said (synth::DawSession::play editor, "", message)

// A request on another ticket completes while the song plays from beat 5.
elsewhere (editor) = synth::DawSession::completed (editor(playStart = 5), "daw-song:other", rendererSaid "")

// No lane under (`x`, `y`).
noLane (editor, x, y) = failsWith (synth::TimelineView::laneAt (editor, x, y), "No lane here.")

transportJourney () =
    liveDialJourney ()
    outputMade ()
    _made = makeDir (transportRoot ())
    _bin = makeDir "${transportRoot ()}/bin"
    editor = synth::EditorState::initial ()
    ready = editor(song = song (), songPath = "${transportRoot ()}/song.json", renderer = "${transportRoot ()}/bin/daw", workerPath = "${transportRoot ()}/bin/worker", rollBar = 1, playStart = 1)
    stopJourney ready
    expect (ready.playBeat, -1.0)
    // [DAW-TRANSPORT-REFUSAL] Each refusal names its own cause and keeps the project.
    refusedPlay (ready(renderer = ""), noRenderer)
    refusedPlay (ready(songPath = ""), "Open a song to play it.")
    expect ((synth::DawSession::play (ready(renderer = ""))).stepStore.song.title, "Bridge")
    refusedPlay (ready(workerPath = ""), "Launch Perception Studio with its audio worker to play the song.")
    idle = synth::DawSession::framed (ready, 1.0)
    expect (idle.stepStore.playBeat, -1.0)
    expect (length idle.requests, 0)
    first = synth::DawSession::play ready
    streamsBars24 first
    savedAs (song (), "${liveFolder ()}/project.json")
    said (synth::DawSession::play first.stepStore, liveTicket (), theSongIsAlready)
    expect (length (synth::DawSession::play first.stepStore).requests, 0)
    followJourney first.stepStore
    // The start marker moves while the song plays; the stream launched is the one that ends.
    moved = first.stepStore
    said (elsewhere moved, liveTicket (), playingBars24)
    over = synth::DawSession::completed (moved(playStart = 5), liveTicket (), rendererSaid "")
    said (over, "", "Bridge finished.")
    halted (over, [ui::Animate(animated = false)])
    succeeds (writeFile "${liveFolder ()}/fault.txt" "Track keys: unknown patch setting.\n", \_ => expect (true, true))
    said (synth::DawSession::completed (first.stepStore, liveTicket (), rendererSaid ""), "", "Playback failed: Track keys: unknown patch setting.")
    said (synth::DawSession::completed (first.stepStore, liveTicket (), Error(message = "The audio device failed.")), "", "Song playback failed: The audio device failed.")
    again = synth::DawSession::play ready
    streamsBars24 again
    expect (fileRead "${liveFolder ()}/fault.txt", "")
    resumed = again.stepStore
    playing = elsewhere resumed
    stopped = synth::DawSession::stop (framedAfter (playing.stepStore, deviceSaid (48000, 0, "true"), 0.25))
    said (stopped, "", "Stopped.")
    halted (stopped, [ui::Cancel(cancelled = liveTicket ()), ui::Animate(animated = false)])
    loopJourney ready
    rangeJourney ready
    headerAction (ready, 5, synth::ToggleLoop)
    _held = stopped.stepStore
    home = synth::DawSession::stop stopped.stepStore
    said (home, "", stopped.stepStore.message)
    expect (stopped.stepStore.playStart, 5)
    expect (home.stepStore.playStart, 5)
    laneSetsBar (ready, 205.0, 205.0, 0)
    // [DAW-TRANSPORT-RANGE] Selecting a track pages the piano roll to it; Play's start marker stays where it was.
    marked = ready(playStart = 2, rollBar = 2)
    forEachList ([synth::DawSession::picked (marked, 0), synth::DawSession::pickedAt (marked, 0, 0), synth::DawSession::focused (marked(track = -1), 0)], \chosen =>
        expect ([chosen.playStart, chosen.track], [2, 0]))
    expect ((synth::DawSession::pickedAt (marked, 0, 0)).rollBar, 0)
    laneSetsBar (ready, 1085.0, 200.0, synth::DawSession::bar (ready.song, daw::Arrangements::beats ready.song))
    noLane (ready, 197.0, 205.0)
    barLineJourney ready
    noLane (ready, 700.0, 192.0)
    succeeds (daw::Projects::mixed (ready.song, 1, 2.0, 0.5), \louder => remixed (ready, louder))
    faderJourney ready
    renderSongJourney ready

hostedTest ("Play streams the range in real time into the audio device, the playhead follows what it sounds, Loop and the end marker set the range, Stop cancels, and Render song writes the whole song", transportJourney)

// [DAW-MIX-BUS] A bus EQ at 0 dB passes its tracks; its compressor ducks them by the sidechain track alone, or
// by the bus itself; tracks route to a declared bus only, and the project file carries the buses.
padsBus (ratio, sidechain) = daw::Bus(name = "pads", output = "", gain = 1.0, equaliser = daw::Equaliser(low = 0.0, mid = 0.0, high = 0.0), compressor = daw::Compressor(threshold = -20.0, ratio = ratio, knee = 0.0, attack = 0.0, release = 0.0, sidechain = sidechain))

steady (value, count) = mapList (toList (range (0, count)), \_ => value)

grouped () = daw::Buses(left = [], right = [], groups = [daw::Stereo(name = "pads", left = steady (0.5, 200), right = steady (0.25, 200))], keys = [daw::Keyed(name = "kick", samples = listConcat (steady (0.0, 100)) (steady (1.0, 100)))])

// −15 dB: a 0 dB key is 20 dB over the −20 dB threshold, and ratio 4 lets 5 dB of it through.
ducked = 0.1778279410038923

closeTo (got, want) = expect (abs (got - want) <= 0.000000001, true)

sampleAt (side, index, want) = closeTo (listGet side index ?: -1.0, want)

// A stereo pair centred at `level`: frame `i` of each side at its share under the pan law.
centred (pair, i, level) =
    sampleAt (pair.left, i, level * daw::ArrangeMath::panLeft 0.0)
    sampleAt (pair.right, i, level * daw::ArrangeMath::panRight 0.0)

routedTo (song, buses) = song(buses = buses)

shaped bus = bus(gain = 2.0, equaliser = daw::Equaliser(low = 6.0, mid = 0.0, high = -6.0))

onPads track = track(bus = "pads")

ducking master =
    lengths (master.left, 200, master.right, 200)
    forEachList ([{ side = master.left, level = 0.5 }, { side = master.right, level = 0.25 }], \row =>
        samplesAt (row.side, [0, 1, 50, 99], row.level)
        samplesAt (row.side, [100, 101, 150, 199], row.level * ducked))

// Every frame in `frames` of `side` reads `want`.
samplesAt (side, frames, want) = forEachList (frames, \i => sampleAt (side, i, want))

selfKeyed master =
    expect ((listGet master.left 150 ?: 0.0) > 0.149 && (listGet master.left 150 ?: 0.0) < 0.150, true)
    sampleAt (master.right, 150, floatDiv (listGet master.left 150 ?: 0.0, 2.0))

boosted master =
    // Bus gain 2: the settled low band at +6 dB, the first sample still mostly the unboosted upper bands.
    expect ((listGet master.left 199 ?: 0.0) > 1.99 && (listGet master.left 199 ?: 0.0) < 1.995, true)
    expect ((listGet master.left 0 ?: 0.0) > 0.73 && (listGet master.left 0 ?: 0.0) < 0.745, true)

keyedRoute buses =
    expect (buses.left, [])
    expect (length buses.groups, 1)
    reads (listGet buses.groups 0, \group => padsGroup (group, 10))
    expect (length buses.keys, 1)
    expect ((listGet buses.keys 0 ?: daw::Keyed(name = "", samples = [])).name, "bell")

// The pads group of `frames` frames.
padsGroup (group, frames) =
    expect (group.name, "pads")
    expect (length group.left, frames)

// The tracks routed to `bus`.
onBus (bus, tracks) = filterList (tracks, \t => t.bus == bus)

projectBuses song =
    expect (length song.buses, 1)
    succeeds (daw::BusMix::named (song, "pads"), \bus => expect (bus.compressor.sidechain, "kick"))
    countOf (onBus ("pads", song.tracks), 2)
    countOf (onBus ("", song.tracks), 15)
    expect ([daw::BusMix::keys (song, "kick"), daw::BusMix::keys (song, "glow")], [true, false])
    failsWith (daw::BusMix::named (song, "drums"), "Bus drums is not in the song.")
    encoded (song, \text => decoded (text, \again => expect (structuralEquals (again.buses, song.buses), true)))

// [DAW-MIX-BUS-OUTPUT] Run every processor once, even with the downstream bus declared first.
busChain song =
    flat = padsBus (1.0, "")
    pads = flat(output = "Print")
    printBus = flat(name = "Print", gain = 0.5, output = "Glue")
    glue = flat(name = "Glue", gain = 0.25)
    forEachList ([[glue, printBus, pads], [pads, glue, printBus]], \order =>
        succeeds (daw::BusMix::mastered (routedTo (song, order), grouped ()), \master =>
            sampleAt (master.left, 150, 0.0625)
            sampleAt (master.right, 150, 0.03125)))
    project = routedTo (song, [glue, printBus, pads])
    succeeds (daw::BusPaths::path (project.buses, "pads"), \names => expect (names, ["pads", "Print", "Glue", "Master"]))
    failsWith (daw::BusPaths::routed (project, "Glue", "pads"), "Bus output cycle: Glue → pads → Print → Glue.")
    failsWith (daw::BusPaths::routed (project, "Print", "Lost"), "Bus output Lost is not in the project.")

busJourney () =
    song = timeline [bellTrack ()]
    busChain song
    forEachList ([
    { buses = [padsBus (4.0, "kick")], groups = grouped (), check = ducking },
    { buses = [padsBus (1.0, "kick")], groups = grouped (), check = \master => sampleAt (master.left, 150, 0.5) },
    { buses = [padsBus (4.0, "")], groups = grouped (), check = selfKeyed },
    { buses = [shaped (padsBus (1.0, ""))], groups = grouped (), check = boosted },
    { buses = [padsBus (4.0, "kick")], groups = daw::Arrangements::empty, check = \master => expect (master.left, []) },
    { buses = [], groups = grouped (), check = \master => expect (master.left, []) }], \row =>
        succeeds (daw::BusMix::mastered (routedTo (song, row.buses), row.groups), row.check))
    failsWith (daw::BusMix::mastered (routedTo (song, [padsBus (4.0, "snare")]), grouped ()), "Bus pads: sidechain snare is not a track in the song.")
    forEachList ([0.5, 21.0], \ratio => failsWith (daw::BusMix::mastered (routedTo (song, [padsBus (ratio, "kick")]), grouped ()), "Bus pads: gain must be 0 to 4, EQ -24 to 24 dB, ratio 1 to 20, knee 0 to 24 dB, attack and release 0 to 2 s."))
    routed = timeline [onPads (bellTrack ())]
    failsWith (trackBuses (routed, daw::Arrangements::empty, onPads (bellTrack ()), 10), "bell: Bus pads is not in the song.")
    succeeds (trackBuses (routedTo (routed, [padsBus (4.0, "bell")]), daw::Arrangements::empty, onPads (bellTrack ()), 10), keyedRoute)
    succeeds (readFile (signalflow::App::fromRepository "src/studio/tracks/codex-version.json"), \text => decoded (text, projectBuses))

journeyTest ("bus EQ passes at 0 dB, the sidechain ducks a bus by exactly its curve, routing and project buses are checked", busJourney)

journeyTest ("arrangements lay tracks on the buses with exact pan and send, place notes on beat frames and refuse bad songs", arrangementsJourney)

// [SYNTH-SHOWCASE] Open the shipped project, round-trip each wired patch through the studio,
// and sound the two voices whose event, control and stereo lanes cross channel boundaries.
showcasePatch (voice, routing) =
    preview = beamed (60, 0.0, 0.03, 1.0)
    succeeds (daw::PatchVoices::patched (preview, routing), \graph =>
        succeeds (daw::PatchRecords::routed (routing, graph), \saved =>
            succeeds (daw::PatchVoices::patched (preview, saved), \again => expect (structuralEquals (graph, again), true))))
    match voice.name == "Spore wheel" || voice.name == "Rivet pulse"
        true => succeeds (sampledAt (preview, voice.instrument, 138.0), \samples =>
            expect (length samples > 1000, true)
            expect (ui::Lists::any (samples, \value => abs value > 0.00001), true))
        false => scoredVoice voice

showcaseKinds voice = match voice.instrument
    daw::PatchInstrument routing => mapList (routing.nodes, \n => n.component)
    _ => []

showcaseVoice voice = match voice.instrument
    daw::PatchInstrument routing => showcasePatch (voice, routing)
    _ => scoredVoice voice

showcaseProject project =
    kinds = ui::Lists::flatten (mapList (project.tracks, showcaseKinds))
    forEachList (["sine", "operator", "additive", "wavetable", "exciter", "bowed", "resonator", "modal", "waveguide", "strikeComb", "fractionalDelay", "lossFilter", "allpass", "lowpass", "modulatedLowpass", "shaper", "shifter", "spectral", "pitchShifter", "smoother", "reverb", "grainCloud", "lfo", "gain", "modulatedGain", "stereoModulatedGain", "mixer", "delay", "midiNote", "midiOscillator", "stereo", "split", "join", "route", "downmix", "stereoOutput", "output"], \kind => expect (ui::Lists::any (kinds, \name => name == kind), true))
    succeeds (trackNamed ("Rivet pulse", project.tracks), \t =>
        expect (t.bus, "Objects")
        expect (structuralEquals (t.sends, [audioSend (6, "Undertow", 0.06)]), true))
    pins = onBus ("Pin bed", project.tracks)
    expect (mapList (pins, \t => t.name), ["Glass pins", "Glass filament", "Porcelain bell"])
    succeeds (daw::BusPaths::path (project.buses, "Pin bed"), \path => expect (path, ["Pin bed", "Objects", "Master"]))
    forEachList (project.tracks, showcaseVoice)

// A track carries its notes.
scoredVoice voice = expect (length voice.notes > 0, true)

// A project opens with its tracks.
playable song = expect (length song.tracks > 0, true)

// The tracks named `name`.
trackNamed (name, tracks) = ui::Lists::find (tracks, \t => t.name == name)

// An enabled send: the track's outlet 0 into `bus` at `level`.
audioSend (source, bus, level) = daw::AudioSend(sendId = 1, source = source, outlet = 0, bus = bus, level = level, enabled = true)

// The shipped Silt Relay project: every wired synth family, and its granular and MIDI channel paths sounding.
showcaseJourney () = succeeds (readFile (signalflow::App::fromRepository "src/studio/tracks/silt-relay.json"), \source => decoded (source, showcaseProject))

journeyTest ("Silt Relay opens its wired synth families and sounds its granular and MIDI channel paths", showcaseJourney)

journeyTest ("every synthesis family plays a real, finite, repeatable note through the song renderer, pitched ones in tune", familiesJourney)

journeyTest ("two internal audio sends survive a project round trip and sum before the track fader", tapJourney)

journeyTest ("the project plays as one loop over time: every track, bus and send advance together into Master, at any block size", masterPlayJourney)
journeyTest ("rendering runs the graph into Master and renders nothing else: no note is made whole or kept", onlyMasterJourney)
journeyTest ("a track carries the project's stereo channels to Master: a left-only patch is heard only on the left", stereoTrackJourney)

journeyTest ("a MIDI note source in a track patch is heard in Master from its note's exact start frame and stops after its gate", midiSourceJourney)

journeyTest ("the codex sub patch without its Mixer→Gain cable plays silent among audible tracks, and reconnected it is heard", codexSubJourney)

// [DAW-PROJECT-MODEL] Every shipped score must open through the production project reader.
test ("every example song opens with playable tracks", \() => Runtime::guarded (\() =>
    succeeds (listDir (signalflow::App::fromRepository "src/studio/tracks"), \entries =>
        scores = filterList (entries, \path => endsWith path ".json")
        expect (ui::Lists::any (scores, \path => endsWith path "/codex-version2.json"), true)
        forEachList (scores, \path => succeeds (readFile path, \source =>
            decoded (source, playable))))))

violetKickJourney () =
    use source <- succeeds (readFile (signalflow::App::fromRepository "src/studio/tracks/violet-static.json"))
    use song <- decoded (source)
    use kick <- succeeds (trackNamed ("Kick", song.tracks))
    routing = daw::TrackPatches::routing kick.instrument
    expect (structuralEquals (mapList (routing.nodes, \n => n.component), ["sample", "output"]), true)
    use n <- reads (listGet routing.nodes 0)
    expect (daw::PatchVoices::fileName n.asset, "808-kick.wav")
    use resource <- succeeds (daw::PatchVoices::sampled (signalflow::App::fromRepository n.asset))
    note = beamed (32, 0.0, 0.2, 1.0)
    use audio <- succeeds (trackPart (timeline [kick], kick(notes = [note]), 256))
    forEachList ([48, 64, 127, 255], \i => reads (listGet audio i, \actual => reads (listGet resource.samples i, \wanted => closeTo (actual, wanted))))

journeyTest ("Violet Static opens the kick as a wired WAV sample", violetKickJourney)

hostedTest ("Every grain control can be reached and edited in both inspectors", dialPagesJourney)

hostedTest ("A page name appears once and empty inspectors omit the parameter heading", pageHeadingsJourney)

hostedTest ("A held mix fader, the following note, Undo and Redo affect the playing song", \() => forEachList ([false, true], liveMixJourney))

hostedTest ("Send level edits and cancellation reach a held note while the project stays saved", liveSendJourney)

journeyTest ("two note makers share a song's distinct notes once, keep them for the next pass and sweep an edited instrument's folder", makerJourney)

test ("the note cache's content address is the FIPS 180-4 SHA-256 of the key", \() => Runtime::guarded digestJourney)
