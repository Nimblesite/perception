import uitest::Drive

octaveArpeggio = "48 + t % 4 * 12"

// [SYNTH-FORMULA-NOTES] A person adds a formula melody from the Add component picker, types formulas into its
// inspector and reads the notes each one plays; a formula that does not parse is refused with its column and
// leaves the patch as it was; a saved melody reopens with its formula.
formulaChoice (driven, text) = Drive::choose (driven, "Formula over step t", text)

melodyText processor = match processor
    synth::FormulaNotes formula => formula
    _ => "not a melody"

formulaOf editor = match synth::Graphs::node (editor.graph, 0)
    synth::Invalid _ => "no melody"
    synth::Valid n => melodyText n.processor

formulaHeld (driven, want) = heldIs (driven, formulaOf, want)

// The caption under the formula: the first sixteen notes it plays.
plays (driven, notes) = showsIn (driven, "Plays ${notes}", true)

repeated (text, times) = join (mapList (toList (range (0, times)), \_ => text), " ")

// One `kind` of component added to an empty patch and chosen in the inspector, each of its `dials` with a real
// range: `check` goes on from the component's added and chosen states.
inspected (kind, dials, check) =
    added = component (openedEditor ["--empty"], kind)
    nodesOf (added, 1)
    selected = inspectorSelected (added, 0)
    forEachList (dials, \text => reads (dialOf (selected, text), \dial => expect (dial.accessMax > dial.accessMin, true)))
    check (added, selected)

// A formula the melody takes: it holds `text` and plays `caption`.
acceptedFormula (driven, text, caption) =
    held = formulaChoice (driven, text)
    formulaHeld (held, text)
    plays (held, caption)
    held

// A formula the melody refuses: it keeps `kept`, says `why` and leaves the graph as it was.
refusedFormula (driven, kept, text, why) =
    refused = formulaChoice (driven, text)
    formulaHeld (refused, kept)
    mentions (refused, why)
    sameGraph (refused, driven)

formulaMenuJourney () = inspected ("formula-notes", ["Velocity", "Step (frames)", "Gate (frames)", "Steps"], \(_added, selected) =>
    formulaHeld (selected, "60 + t * 7 % 12")
    plays (selected, "C4 G4 D4 A4 E4 B4 F♯4 C♯4 G♯4 D♯4 A♯4 F4 C4 G4 D4 A4")
    offeredIn (selected, "Canvas output 0:0", true)
    octaves = acceptedFormula (selected, octaveArpeggio, repeated ("C3 C4 C5 C6", 4))
    mentions (octaves, "Patch updated.")
    refusedFormula (octaves, octaveArpeggio, "48 + )", "Formula: unexpected ')' at column 6.")
    refusedFormula (octaves, octaveArpeggio, "48 + x", "Formula: unknown name 'x'; use t, sin, cos, abs, floor, round or sqrt.")
    resting = acceptedFormula (octaves, "60 / (t % 2)", repeated ("rest C4", 8))
    folded = formulaChoice (resting, "130 + t")
    plays (folded, "A♯8 B8 C9 C♯9 D9 D♯9 E9 F9 F♯9 G9 G♯8 A8 A♯8 B8 C9 C♯9"))

// A saved melody keeps its formula in the project's asset and reopens as the same graph; a project whose
// formula no longer parses says why the track cannot open.
projectFormulaJourney () =
    melody = synth::Components::formulaMelody (21, octaveArpeggio)
    sine = synth::Components::sine (22, 440.0)
    voice = sine(inputs = [synth::Port(name = "notes", rate = synth::Events, channels = 1, unit = synth::Notes)])
    valid (synth::Patches::built ([melody, voice, synth::Components::output 23], [flowRoute (21, 22, 0), flowRoute (22, 23, 0)]), \graph =>
        patchCodec (graph, \source => sourceContains (source, [{ text = "\"component\":\"formulaNotes\"", wanted = true }, { text = "\"asset\":\"48 + t % 4 * 12\"", wanted = true }])))
    broken = sourced ("formulaNotes", 0, "60 +")
    brokenTrack = patchTrack ("broken", [broken], [], 0.1)
    failsWith (daw::TrackPatches::patch brokenTrack, "formulaNotes 1: Formula: the formula ends where a number, t, a function or '(' belongs.")

// [STUDIO-ROUTING-VERIFY] The graph-edit journey through the hosted canvas: seven modules from the Add component
// menu, cables drawn by tapping an output socket then an input socket, a cycle and an event-into-audio route
// refused with the snapshot unchanged, a cable cut and redrawn, and a connected node deleted from its menu.
socketKinds = ["sine", "sine", "gain", "gain", "mixer", "output", "midi-note"]

socketRoutes = [{ s = 0, d = 2, i = 0 }, { s = 0, d = 3, i = 0 }, { s = 2, d = 4, i = 0 }, { s = 3, d = 4, i = 1 }, { s = 4, d = 5, i = 0 }]

// The routes the sockets refuse: a MIDI generator's event outlet into audio, and a cycle back into a module feeding it.
socketRefusedRoutes = [{ s = 6, d = 2, i = 0 }, { s = 4, d = 2, i = 0 }]

socketRefused (patched, bad) =
    refused = linked (patched, bad.s, bad.d, bad.i)
    sameGraph (refused, patched)
    nonEmpty (Drive::holding refused).message

socketGraphJourney () =
    added = chained (openedEditor ["--empty"], socketKinds)
    nodesOf (added, 7)
    patched = foldList (socketRoutes, added, \(d, c) => linked (d, c.s, c.d, c.i))
    cablesOf (patched, 5)
    forEachList (socketRoutes, \c => offeredIn (patched, "Cable ${c.s}:0 to ${c.d}:${c.i}", true))
    forEachList (socketRefusedRoutes, \bad => socketRefused (patched, bad))
    offeredIn (patched, "Canvas input 5:3", false)
    unplugged = cutCable (patched, "Cable 0:0 to 3:0")
    cablesOffered (unplugged, 4, "Cable 0:0 to 3:0", false)
    rerouted = linked (unplugged, 1, 3, 0)
    cablesOffered (rerouted, 5, "Cable 1:0 to 3:0", true)
    gone = deleteNode (rerouted, 4)
    expect (mapList ((Drive::holding gone).graph.nodes, \n => n.identity), [0, 1, 2, 3, 5, 6])
    cablesOf (gone, 2)
    forEachList (["Cable 0:0 to 2:0", "Cable 1:0 to 3:0"], \label => offeredIn (gone, label, true))

// [STUDIO-PATCH-LAYOUT] A patch with no saved positions is laid out along its signal flow: sources on the left,
// the Output on the right, one column per step, branches stacked, no card over another or over a saved card,
// and no cable through a card (sampled along the straight line between the two sockets).
flowRoute (s, d, i) = synth::Components::route (s, 0, d, i)

flowNodes () = [synth::Components::sine (1, 220.0), synth::Components::gain (2, 0.5), synth::Components::gain (3, 0.5), synth::Components::mixer 4, synth::Components::output 5]

// A fan-out that merges, a skip cable over a two-card chain, and a skip over one card into the Output's mixer.
flowGraphs () = mapList ([[{ s = 1, d = 2, i = 0 }, { s = 1, d = 3, i = 0 }, { s = 2, d = 4, i = 0 }, { s = 3, d = 4, i = 1 }, { s = 4, d = 5, i = 0 }], [{ s = 1, d = 2, i = 0 }, { s = 2, d = 3, i = 0 }, { s = 3, d = 4, i = 0 }, { s = 1, d = 4, i = 1 }, { s = 4, d = 5, i = 0 }], [{ s = 1, d = 2, i = 0 }, { s = 2, d = 4, i = 0 }, { s = 1, d = 3, i = 0 }, { s = 3, d = 4, i = 1 }, { s = 2, d = 5, i = 0 }]], \routes => mapList (routes, \c => flowRoute (c.s, c.d, c.i)))

flowAt (placed, id) = ui::Lists::find (placed, \p => p.layoutNode == id) ?: daw::NodePosition(layoutNode = id, layoutX = -9999.0, layoutY = -9999.0)

within (value, centre, half) = value > centre - half && value < centre + half

overCard (placed, c, x, y) = ui::Lists::any (placed, \p => p.layoutNode != c.source && p.layoutNode != c.destination && within (x, p.layoutX, 146.0) && within (y, p.layoutY, 90.0))

cablePoint (placed, c, i) =
    head = flowAt (placed, c.source)
    tail = flowAt (placed, c.destination)
    share = toFloat i / 32.0
    overCard (placed, c, head.layoutX + 146.0 + (tail.layoutX - head.layoutX - 292.0) * share, head.layoutY + (tail.layoutY - head.layoutY) * share)

throughCard (placed, c) = ui::Lists::any (toList (range (1, 32)), \i => cablePoint (placed, c, i))

apart (one, other) = one.layoutNode == other.layoutNode || synth::CanvasGeometry::collides (one.layoutX, one.layoutY, other.layoutX, other.layoutY) == false

flowChecked (graph, placed, saved) =
    expect (length placed, length graph.nodes)
    forEachList (placed, \p => forEachList (listConcat placed saved, \q => expect (apart (p, q), true)))
    forEachList (graph.cables, \c =>
        expect ((flowAt (placed, c.destination)).layoutX > (flowAt (placed, c.source)).layoutX, true)
        expect (throughCard (placed, c), false))
    expect ((flowAt (placed, 1)).layoutX, 350.0)
    expect (ui::Lists::any (placed, \p => p.layoutX > (flowAt (placed, 5)).layoutX), false)

flowPlanned graph = match synth::Graphs::prepare graph
    synth::Invalid _ => expect (false, true)
    synth::Valid plan =>
        flowChecked (graph, synth::EditorLayout::flow (plan, []), [])
        saved = [daw::NodePosition(layoutNode = 9, layoutX = 350.0, layoutY = 170.0), daw::NodePosition(layoutNode = 8, layoutX = 690.0, layoutY = 405.0)]
        flowChecked (graph, synth::EditorLayout::flow (plan, saved), saved)

flowLayoutJourney () = forEachList (flowGraphs (), \routes => valid (synth::Patches::built (flowNodes (), routes), flowPlanned))
