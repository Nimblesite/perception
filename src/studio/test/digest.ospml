// [DAW-RENDER] The note cache names each track's folder by the SHA-256 of its content key: FIPS 180-4
// known answers, including the two-block 56-byte message and a key longer than one block.
digestAnswers = [
    { text = "", hex = "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855" },
    { text = "abc", hex = "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad" },
    { text = "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq", hex = "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1" },
    { text = "The quick brown fox jumps over the lazy dog", hex = "d7a8fbb307d7809469ca9abcb0082e4f8d5651e46d3cdb762d02d0bf37c9e592" }
]

digestJourney () = forEachList (digestAnswers, \answer => expect (digest::Sha256::ofString answer.text, answer.hex))
