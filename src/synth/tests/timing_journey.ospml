import synth::Components
import synth::Timings

// [SYNTH-ADVANCED-CORE-RESOURCES] Measure host compensation in samples at the graph's 48 kHz rate.
timingCase (n, latency, tail) =
    latencyIs (n, latency)
    succeeds (Timings::tail n, \samples => expect (samples, tail))

registerTimingJourney () = test ("component timing declares delay and decay in samples, tracks oversampling switches and rejects missing controls", \() => arithmetic (\() =>
    // Each processor with the delay and decay it declares, in samples at the graph's 48 kHz rate.
    phaseNode = Components::phaseOperator (1, 440.0, 0.0)
    shaper = Components::shaper (1, 0.0, 2.0)
    over = grainSet (shaper, "oversample", 1.0)
    forEachList ([{ n = Components::sine (1, 440.0), latency = 0.0, tail = 0.0 }, { n = Components::waveguide (1, 220.0, 512), latency = 0.0, tail = 144000.0 }, { n = Components::bowed (1, 220.0, 512), latency = 0.0, tail = 96000.0 }, { n = Components::resonator (1, 440.0), latency = 0.0, tail = 72000.0 }, { n = Components::modalBank (1, 220.0, 1.0), latency = 0.0, tail = 240000.0 }, { n = Components::reverb (1, 1.5), latency = 0.0, tail = 144000.0 }, { n = Components::smoother (1, 0.5), latency = 0.0, tail = 168000.0 }, { n = Components::additive (1, 440.0), latency = 0.0, tail = 28800000.0 }, { n = Components::delay (1, 64), latency = 64.0, tail = 64.0 }, { n = Components::fractionalDelay (1, 7.25, 32), latency = 7.25, tail = 7.25 }, { n = phaseNode, latency = 0.0, tail = 0.0 }, { n = grainSet (phaseNode, "oversample", 1.0), latency = 7.5, tail = 0.0 }, { n = shaper, latency = 0.5, tail = 0.0 }, { n = over, latency = 15.5, tail = 0.0 }, { n = grainSet (over, "antialias", 0.0), latency = 0.0, tail = 0.0 }], \c => timingCase (c.n, c.latency, c.tail))
    hall = Components::reverb (1, 1.0)
    refusedAs (Timings::latency (shaper(parameters = [])), "configuration", "The node lacks a timing parameter: oversample.")
    refusedAs (Timings::tail (hall(parameters = [])), "configuration", "The node lacks a timing parameter: decay.")))
